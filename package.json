    "@redocly/openapi-core": "2.71.1",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "ajv-formats": "3.0.1",
    "lossless-json": "4.3.3",
    "openapi-enforcer": "1.23.0",
