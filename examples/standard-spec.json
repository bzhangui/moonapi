{
  "openapi": "3.0.3",
  "info": {
    "title": "MoonAPI non-CRUD synthetic quotation API",
    "version": "1"
  },
  "paths": {
    "/quote": {
      "post": {
        "operationId": "quote",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  {
                    "type": "object",
                    "required": ["quantity"],
                    "properties": {
                      "quantity": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10,
                        "multipleOf": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": ["sku"],
                    "properties": {
                      "sku": {
                        "type": "string",
                        "pattern": "^[A-Z]{3}$",
                        "minLength": 3,
                        "maxLength": 3
                      }
                    }
                  }
                ],
                "example": { "quantity": 2, "sku": "ABC" }
              }
            }
          }
        },
        "responses": {
          "2XX": {
            "description": "Valid quote",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          },
          "400": {
            "description": "Rejected input",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "operationId": "search",
        "parameters": [
          {
            "name": "tags",
            "in": "query",
            "required": true,
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "uniqueItems": true,
              "items": { "type": "string", "enum": ["blue", "red"] }
            }
          },
          {
            "name": "x-client",
            "in": "header",
            "required": true,
            "schema": { "type": "string", "enum": ["synthetic"] }
          },
          {
            "name": "session",
            "in": "cookie",
            "required": true,
            "schema": { "type": "string", "enum": ["fixture"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Search result",
            "headers": {
              "x-count": {
                "required": true,
                "schema": { "type": "integer", "minimum": 1 }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          },
          "400": {
            "description": "Rejected input",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Result" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Result": {
        "type": "object",
        "required": ["ok"],
        "properties": { "ok": { "type": "boolean" } },
        "additionalProperties": false
      }
    }
  }
}
